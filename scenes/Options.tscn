[sub_resource type="GDScript" id="GDScript_nmn1p"]
script/source = "extends FoldableContainer

func _ready() -> void:
	self.fold()

func _on_folding_changed(_is_folded: bool) -> void:
	size_flags_vertical = Control.SIZE_EXPAND_FILL if !_is_folded else Control.SIZE_SHRINK_BEGIN
"

[sub_resource type="GDScript" id="GDScript_ej4sg"]
script/source = "extends OptionButton

var up:bool = false

func _init() -> void:
	Master.courses_update.connect(func(): up = true)

func _ready() -> void:
	update()

func _process(_delta: float) -> void:
	if up:
		update()

func update() -> void:
	self.clear()
	self.add_item(\"EMPTY\")
	for val in Master.list_of_courses:
		self.add_item(Master.list_of_courses[val])
	up = false
	if Master.course_id != null and !Master.list_of_courses.is_empty():
		var c_id = func(_id:int) -> int:
			var result: int = 1
			for c1 in Master.list_of_courses:
				if c1 == str(_id):
					break
				result += 1
			return result
		self.select(c_id.call(Master.course_id))

func _on_item_selected(index: int) -> void:
	Master.course_id = Master.list_of_courses.keys()[index-1]
	Master.get_course_groups()
"

[sub_resource type="GDScript" id="GDScript_j6yq7"]
script/source = "extends OptionButton

var up:bool = false

func _init() -> void:
	Master.groups_update.connect(func(): up = true)

func _ready() -> void:
	update()

func _process(_delta: float) -> void:
	if up:
		update()

func update() -> void:
	self.clear()
	self.add_item(\"EMPTY\")
	for val in Master.list_of_groups:
		self.add_item(Master.list_of_groups[val])
	up = false
	if Master.group_id != null and !Master.list_of_groups.is_empty():
		var c_id = func(_id:int) -> int:
			var result: int = 1
			for c1 in Master.list_of_groups:
				if c1 == str(_id):
					break
				result += 1
			return result
		self.select(c_id.call(Master.group_id))

func _on_item_selected(index: int) -> void:
	Master.group_id = Master.list_of_groups.keys()[index-1]
	Master.get_lessons()
"

[sub_resource type="GDScript" id="GDScript_ckjey"]
script/source = "extends OptionButton

var up:bool = false

func _init() -> void:
	Master.subgroups_update.connect(func(): up = true)

func _ready() -> void:
	update()

func _process(_delta: float) -> void:
	if up:
		update()

func update() -> void:
	if Master.subgroup_id != null:
		match Master.subgroup_id:
			\"A\": self.select(0)
			\"B\": self.select(1)

func _on_item_selected(index: int) -> void:
	match index:
		0: Master.subgroup_id = \"A\"
		1: Master.subgroup_id = \"B\"
	Master.subgroups_update.emit()
"

